# ============================================================================
# NOMEKOP BEQUEST - ENVIRONMENT VARIABLES
# ============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# ============================================================================

# ============================================================================
# SUPABASE CONFIGURATION
# ============================================================================
# Get these values from: npx supabase status (for local)
# Or from your Supabase project dashboard (for production)

# Supabase Project URL
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321

# Supabase Anonymous Key (safe to expose in client-side code)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key (NEVER expose in client-side code!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Application URL (for redirects and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Environment (development, staging, production)
NODE_ENV=development

# ============================================================================
# AUTHENTICATION
# ============================================================================

# JWT Secret (used for additional JWT verification if needed)
JWT_SECRET=your-jwt-secret-here

# Session timeout (in seconds)
SESSION_TIMEOUT=3600

# ============================================================================
# EMAIL CONFIGURATION (Production)
# ============================================================================
# For local development, emails are captured in Inbucket
# For production, configure your SMTP provider

# SMTP Host
SMTP_HOST=smtp.sendgrid.net

# SMTP Port
SMTP_PORT=587

# SMTP Username
SMTP_USER=apikey

# SMTP Password / API Key
SMTP_PASSWORD=your-sendgrid-api-key-here

# Email sender
EMAIL_FROM=noreply@nomekopbequest.com
EMAIL_FROM_NAME=Nomekop Bequest

# ============================================================================
# BLOCKCHAIN / WEB3 CONFIGURATION
# ============================================================================

# Alchemy API Key (for Ethereum)
ALCHEMY_API_KEY=your-alchemy-api-key-here

# Infura API Key (alternative to Alchemy)
INFURA_API_KEY=your-infura-api-key-here

# WalletConnect Project ID
WALLETCONNECT_PROJECT_ID=your-walletconnect-project-id-here

# Supported Chain IDs (comma-separated)
SUPPORTED_CHAIN_IDS=1,137,42161

# ============================================================================
# STORAGE / CDN
# ============================================================================

# Supabase Storage URL (for user avatars, assets, etc.)
NEXT_PUBLIC_SUPABASE_STORAGE_URL=http://127.0.0.1:54321/storage/v1

# CDN URL (if using external CDN)
# CDN_URL=https://cdn.nomekopbequest.com

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================

# Google Analytics ID
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry DSN (for error tracking)
# SENTRY_DSN=your-sentry-dsn-here

# LogRocket App ID (for session replay)
# LOGROCKET_APP_ID=your-logrocket-id-here

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Enable blockchain features
NEXT_PUBLIC_ENABLE_WEB3=true

# Enable social features
NEXT_PUBLIC_ENABLE_SOCIAL=true

# Enable in-game purchases
NEXT_PUBLIC_ENABLE_PURCHASES=false

# Enable debug mode
NEXT_PUBLIC_DEBUG=false

# ============================================================================
# RATE LIMITING
# ============================================================================

# API rate limit (requests per minute)
API_RATE_LIMIT=60

# Login attempt limit (before lockout)
LOGIN_ATTEMPT_LIMIT=5

# ============================================================================
# SECURITY
# ============================================================================

# CORS allowed origins (comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Cookie domain
COOKIE_DOMAIN=localhost

# Cookie secure flag (true for production)
COOKIE_SECURE=false

# ============================================================================
# DATABASE (Advanced - usually handled by Supabase)
# ============================================================================

# Direct database connection string (for migrations, backups, etc.)
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# ============================================================================
# THIRD-PARTY INTEGRATIONS
# ============================================================================

# Discord Bot Token (if integrating Discord)
# DISCORD_BOT_TOKEN=your-discord-bot-token

# Twitter API Keys (if integrating Twitter/X)
# TWITTER_API_KEY=your-twitter-api-key
# TWITTER_API_SECRET=your-twitter-api-secret

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# Enable source maps in production
GENERATE_SOURCEMAP=false

# Enable type checking in development
NEXT_TELEMETRY_DISABLED=1

# ============================================================================
# NOTES
# ============================================================================
# - Replace all placeholder values with your actual credentials
# - Keep .env file secure and never commit it to git
# - Use different values for development, staging, and production
# - Rotate secrets regularly for security
# - Consider using a secrets manager for production (AWS Secrets Manager, Vault, etc.)
# ============================================================================
